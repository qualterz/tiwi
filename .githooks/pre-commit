#!/bin/sh
set -e

if [ -f web/node_modules/prettier/bin/prettier.cjs ]; then
  git diff --cached --name-only --diff-filter=ACMR -z -- ':!daemon/' ':!obs/' | xargs -0 -r node web/node_modules/prettier/bin/prettier.cjs --write --ignore-unknown --config web/package.json --ignore-path .gitignore --
fi
git diff --cached --name-only --diff-filter=ACMR -z -- '*.rs' | xargs -0 -r rustfmt --edition 2024 --
git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 -r git add --
