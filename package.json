{
  "name": "tiwi",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:daemon": "bun run --filter @qualterz/tiwi dev",
    "dev:dashboard": "bun run --filter @tiwi/dashboard dev",
    "dev:viewer": "bun run --filter @tiwi/viewer dev",
    "build": "bun run --filter '*' build",
    "build:dashboard": "bun run --filter @tiwi/dashboard build",
    "build:viewer": "bun run --filter @tiwi/viewer build",
    "typecheck": "bun run --filter '*' typecheck",
    "format": "prettier --write . --ignore-path .gitignore",
    "format:check": "prettier --check . --ignore-path .gitignore"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.10.1"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "prettier": {
    "quoteProps": "consistent"
  }
}
